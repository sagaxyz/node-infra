---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-shared-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  DATABASE_URL: "postgresql://{{ explorer_db.user }}:{{ explorer_db.password }}@postgres:5432/blockscout-{{ dex_chain_id }}"
  ETHEREUM_JSONRPC_HTTP_URL: "http://chainlet.{{ dex_chain_namespace }}.svc.cluster.local:8545"
  ETHEREUM_JSONRPC_WS_URL: "ws://chainlet.{{ dex_chain_namespace }}.svc.cluster.local:8546"
  SECRET_KEY_BASE: "{{ explorer_secret_key_base }}"
  ECTO_USE_SSL: "false"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "blockscout-indexer"
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: "blockscout-indexer"
  template:
    metadata:
      labels:
        app: "blockscout-indexer"
        chainId: "{{ dex_chain_id }}-dex"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "4000"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - name: blockscout-indexer
          image: ghcr.io/blockscout/blockscout:8.0.1
          resources:
            requests:
              cpu: "2"
              memory: 12Gi
            limits:
              cpu: "4"
              memory: 24Gi
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
          args:
            - -c
            - bin/blockscout eval "Elixir.Explorer.ReleaseTasks.create_and_migrate()" && bin/blockscout start
          ports:
            - containerPort: 4000
              protocol: TCP
          envFrom:
            - configMapRef:
                name: blockscout-shared-configmap
          env:
            - name: APPLICATION_MODE
              value: "indexer"
            - name: DISABLE_WEBAPP
              value: "true"
            - name: API_V1_READ_METHODS_DISABLED
              value: "true"
            - name: API_V1_WRITE_METHODS_DISABLED
              value: "true"
            - name: DISABLE_API
              value: "true"
            - name: API_V2_ENABLED
              value: "false"
            - name: CHAIN_ID
              value: "{{ dex_chain_id }}"
            - name: JSON_RPC
              value: "https://sagaevm.jsonrpc.{{ rpc_url_suffixes[0] }}"
            - name: INDEXER_MEMORY_LIMIT
              value: "10Gi"
            - name: ETHEREUM_JSONRPC_DEBUG_TRACE_TRANSACTION_TIMEOUT
              value: "15s"
            - name: INDEXER_TX_ACTIONS_ENABLE
              value: "true"
            - name: INDEXER_TX_ACTIONS_UNISWAP_V3_FACTORY_CONTRACT
              value: "0x454050C4c9190390981Ac4b8d5AFcd7aC65eEffa"
            - name: INDEXER_TX_ACTIONS_UNISWAP_V3_NFT_POSITION_MANAGER_CONTRACT
              value: "0xdD489C75be1039ec7d843A6aC2Fd658350B067Cf"
            - name: INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE
              value: "opcode"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      containers:
        - name: postgres
          image: postgres:14
          ports:
            - containerPort: 5432
          env:
            - name: POSTGRES_USER
              value: "{{ explorer_db.user }}"
            - name: POSTGRES_PASSWORD
              value: "{{ explorer_db.password }}"
            - name: POSTGRES_DB
              value: "blockscout-{{ dex_chain_id }}"
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
            - name: POSTGRES_MAX_CONNECTIONS
              value: "200"
          resources:
            requests:
              memory: "1Gi"
              cpu: "0.5"
            limits:
              memory: "2Gi"
              cpu: "1"
          volumeMounts:
            - name: postgres-pvc
              mountPath: /var/lib/postgresql/data/pgdata
              subPath: pgdata
      volumes:
        - name: postgres-pvc
          persistentVolumeClaim:
            claimName: postgres-pvc
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-pvc
  namespace: "{{ dex_service_namespace }}"
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 100Gi
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: "{{ dex_service_namespace }}"
spec:
  ports:
    - port: 5432
  selector:
    app: postgres
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-backend-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  API_V2_ENABLED: "true"
  PERMANENT_DARK_MODE_ENABLED: "true"
  ETHEREUM_JSONRPC_VARIANT: geth
  ETHEREUM_JSONRPC_HTTP_URL: "http://{{ dex_vanity_name }}:8545"
  ETHEREUM_JSONRPC_WS_URL: "ws://{{ dex_vanity_name }}:8546"
  DATABASE_URL: "postgresql://{{ explorer_db_user }}:{{ explorer_db_pwd }}@blockscout-db.blockscout.svc.cluster.local:5432/blockscout-{{ dex_chain_id }}"
  DATABASE_READ_ONLY_API_URL: "postgresql://{{ explorer_db_user }}:{{ explorer_db_pwd }}@blockscout-db-ro.blockscout.svc.cluster.local:5432/blockscout-{{ dex_chain_id }}"
  NETWORK: ""
  SUBNETWORK: "{{ dex_vanity_name }}"
  LOGO: /images/saga_logo.svg
  LOGO_FOOTER: /images/saga_logo.svg
  ETHEREUM_JSONRPC_TRANSPORT: http
  PORT: "4000"
  COIN_NAME: {{ coin_denom }}
  COIN: {{ coin_denom }}
  POOL_SIZE: "5"
  POOL_SIZE_API: "5"
  ECTO_USE_SSL: "true"
  HEART_BEAT_TIMEOUT: "30"
  BLOCK_TRANSFORMER: base
  CHAIN_ID: "{{ dex_chain_id }}"
  SECRET_KEY_BASE: "{{ explorer_secret_key_base }}"
  DISABLE_WEBAPP: "true"
  INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE: "opcode"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-frontend-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  NEXT_PUBLIC_APP_HOST: "{{ dex_vanity_name }}.explorer.{{ explorer_url_suffix }}"
  NEXT_PUBLIC_NETWORK_RPC_URL: "https://{{ dex_vanity_name }}.jsonrpc.{{ explorer_url_suffix }}"
  NEXT_PUBLIC_APP_PORT: "443"
  NEXT_PUBLIC_NETWORK_NAME: "{{ dex_vanity_name }}"
  NEXT_PUBLIC_NETWORK_SHORT_NAME: "{{ dex_vanity_name }}"
  NEXT_PUBLIC_NETWORK_ID: "{{ dex_chain_id }}"
  NEXT_PUBLIC_NETWORK_CURRENCY_NAME: "{{ coin_denom }}"
  NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL: "{{ coin_denom }}"
  NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE: "validation"
  NEXT_PUBLIC_IS_TESTNET: "{{ explorer_is_testnet }}"
  NEXT_PUBLIC_API_HOST: "api-{{ dex_vanity_name }}.explorer.{{ explorer_url_suffix }}"
  NEXT_PUBLIC_STATS_API_HOST: "https://stats-{{ dex_vanity_name }}.explorer.{{ explorer_url_suffix }}"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-stats-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  STATS__SERVER__HTTP__ENABLED: "true"
  STATS__SERVER__HTTP__ADDR: "0.0.0.0:8051"
  STATS__SERVER__HTTP__MAX_BODY_SIZE: "2097152"
  STATS__DEFAULT_SCHEDULE: "0 0 1 * * * *"
  STATS__TRACING__ENABLED: "true"
  STATS__TRACING__FORMAT: "default"
  STATS__DB_URL: "postgresql://{{ explorer_db_user }}:{{ explorer_db_pwd }}@blockscout-db-stats.blockscout.svc.cluster.local:5432/stats-{{ dex_chain_id }}"
  STATS__BLOCKSCOUT_DB_URL: "postgresql://{{ explorer_db_user }}:{{ explorer_db_pwd }}@blockscout-db-ro.blockscout.svc.cluster.local:5432/blockscout-{{ dex_chain_id }}"
  STATS__CREATE_DATABASE: "true"
  STATS__RUN_MIGRATIONS: "true"
  STATS__METRICS__ENABLED: "false"
  STATS__METRICS__ADDR: "0.0.0.0:6060"
  STATS__METRICS__ROUTE: "/metrics"
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-backend
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-backend
spec:
  type: ClusterIP
  selector:
    app: blockscout-backend
  ports:
    - targetPort: 4000
      port: 4000
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-stats
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-stats
spec:
  type: ClusterIP
  selector:
    app: blockscout-stats
  ports:
    - targetPort: 8051
      port: 8051
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-frontend
spec:
  type: ClusterIP
  ports:
    - targetPort: 3000
      port: 3000
  selector:
    app: blockscout-frontend
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
  annotations:
    saga.xyz/ingress-protocol: "explorer"
spec:
  ingressClassName: nginx
  rules:
    - host: "{{ dex_vanity_name }}.explorer.{{ explorer_url_suffix }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: blockscout-frontend
                port:
                  number: 3000
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-backend
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-backend
  template:
    metadata:
      labels:
        app: blockscout-backend
    spec:
      containers:
        - name: blockscout-backend
          image: blockscout/blockscout:latest
          ports:
            - containerPort: 4000
          envFrom:
            - configMapRef:
                name: blockscout-backend-configmap
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-frontend
  template:
    metadata:
      labels:
        app: blockscout-frontend
    spec:
      containers:
        - name: blockscout-frontend
          image: blockscout/frontend:latest
          ports:
            - containerPort: 3000
          envFrom:
            - configMapRef:
                name: blockscout-frontend-configmap
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-stats
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-stats
  template:
    metadata:
      labels:
        app: blockscout-stats
    spec:
      containers:
        - name: blockscout-stats
          image: blockscout/stats:latest
          ports:
            - containerPort: 8051
          envFrom:
            - configMapRef:
                name: blockscout-stats-configmap
