---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-shared-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  DATABASE_URL: "postgresql://{{ explorer_db.user }}:{{ explorer_db.password }}@postgres:5432/blockscout-{{ dex_chain_id }}"
  ETHEREUM_JSONRPC_HTTP_URL: "http://chainlet-fullnode:8545"
  ETHEREUM_JSONRPC_WS_URL: "ws://chainlet-fullnode:8546"
  SECRET_KEY_BASE: "{{ explorer_secret_key_base }}"
  ECTO_USE_SSL: "false"
  CHAIN_ID: "{{ dex_chain_id_number }}"
  JSON_RPC: "{{ dex_public_rpc }}"
  ETHEREUM_JSONRPC_TRACE_URL: "http://chainlet-fullnode-tracing:8545"
  NETWORK: "Saga"
  SUBNETWORK: "{{ dex_vanity_name }}"
  DISABLE_WEBAPP: "true"
  INDEXER_INTERNAL_TRANSACTIONS_TRACER_TYPE: "opcode"

  DISABLE_MARKET: "true"
  MARKET_COIN_FETCHER_ENABLED: "false"
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-frontend-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  NEXT_PUBLIC_APP_HOST: "{{ dex_explorer_frontend_url }}"
  NEXT_PUBLIC_APP_PORT: "443"
  NEXT_PUBLIC_NETWORK_NAME: "{{ dex_vanity_name }}"
  NEXT_PUBLIC_NETWORK_SHORT_NAME: "{{ dex_vanity_name }}"
  NEXT_PUBLIC_NETWORK_ID: "{{ dex_chain_id.split('_')[1].split('-')[0] }}"
  NEXT_PUBLIC_NETWORK_RPC_URL: "{{ dex_public_rpc }}"
  NEXT_PUBLIC_HIDE_INDEXING_ALERT_BLOCKS: "true"
  NEXT_PUBLIC_NETWORK_VERIFICATION_TYPE: "validation"
  NEXT_PUBLIC_IS_TESTNET: "{{ is_testnet }}"
  NEXT_PUBLIC_API_HOST: "{{ dex_explorer_backend_url }}"
  NEXT_PUBLIC_HOMEPAGE_CHARTS: "['daily_txs']"
  NEXT_PUBLIC_HOMEPAGE_STATS: "['total_blocks', 'average_block_time', 'total_txs', 'wallet_addresses']"
  NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_CONFIG: "{ 'background': ['linear-gradient(280deg, rgba(255,255,255,1) 0%, rgba(102,235,227,1) 25%, rgba(36,226,215,1) 50%, rgba(22,136,129,1) 75%, rgba(25,9,51,1) 100%);']}"
  NEXT_PUBLIC_NETWORK_LOGO_DARK: "https://saga-public-assets.s3.amazonaws.com/blockscout/images/public_network_logo_dark.svg"
  NEXT_PUBLIC_NETWORK_LOGO: "https://saga-public-assets.s3.amazonaws.com/blockscout/images/public_network_logo.svg"
  NEXT_PUBLIC_NETWORK_ICON: "https://saga-public-assets.s3.amazonaws.com/blockscout/images/public_network_icon.svg"
  NEXT_PUBLIC_NETWORK_ICON_DARK: "https://saga-public-assets.s3.amazonaws.com/blockscout/images/public_network_icon_dark.svg"
  NEXT_PUBLIC_OTHER_LINKS: "[{'url':'https://oku.trade/app/saga','text':'Oku'}, {'url':'https://app.squidrouter.com/?chains=ssc-1%2C5464&tokens=usaga%2C0xa19377761fed745723b90993988e04d641c2cffe','text':'Squid'}]"
  NEXT_PUBLIC_FOOTER_LINKS: "https://saga-public-assets.s3.amazonaws.com/blockscout/configs/footer_links.json"
  NEXT_PUBLIC_PROMOTE_BLOCKSCOUT_IN_TITLE: "false"
  NEXT_PUBLIC_OG_DESCRIPTION: "Saga is more than your own dedicated and configurable blockchain - it’s a vibrant community where innovators are collaborating, learning, sharing, and creating the future together. Welcome to Saga, welcome to the Multiverse."
  NEXT_PUBLIC_OG_IMAGE_URL: "https://saga-public-assets.s3.amazonaws.com/blockscout/images/public_og_image.jpg"
  NEXT_PUBLIC_GAS_TRACKER_ENABLED: "false"
  NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID: "{{ wallet_id_connect_client_id }}"
  NEXT_PUBLIC_AD_BANNER_PROVIDER: "none"
  NEXT_PUBLIC_AD_TEXT_PROVIDER: "none"
  NEXT_PUBLIC_HAS_BEACON_CHAIN: "false"
  NEXT_PUBLIC_MARKETPLACE_ENABLED: "false"
  NEXT_PUBLIC_STATS_API_HOST: "https://{{ dex_explorer_stats_url }}"
  NEXT_PUBLIC_NETWORK_CURRENCY_NAME: "gas"
  NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL: "gas"
  NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS: "18"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: "blockscout-indexer"
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: "blockscout-indexer"
  template:
    metadata:
      labels:
        app: "blockscout-indexer"
        chainId: "{{ dex_chain_id }}-dex"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "4000"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - name: blockscout-indexer
          image: {{ dex_explorer.images.indexer }}
          resources:
            requests:
              cpu: "2"
              memory: 12Gi
            limits:
              cpu: "4"
              memory: 24Gi
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
          args:
            - -c
            - bin/blockscout eval "Elixir.Explorer.ReleaseTasks.create_and_migrate()" && bin/blockscout start
          ports:
            - containerPort: 4000
              protocol: TCP
          envFrom:
            - configMapRef:
                name: blockscout-shared-configmap
          env:
            - name: APPLICATION_MODE
              value: "indexer"
            - name: API_V1_READ_METHODS_DISABLED
              value: "true"
            - name: API_V1_WRITE_METHODS_DISABLED
              value: "true"
            - name: DISABLE_API
              value: "true"
            - name: API_V2_ENABLED
              value: "false"
            - name: INDEXER_MEMORY_LIMIT
              value: "10Gi"
            - name: ETHEREUM_JSONRPC_DEBUG_TRACE_TRANSACTION_TIMEOUT
              value: "15s"
            - name: INDEXER_TX_ACTIONS_ENABLE
              value: "true"
            - name: INDEXER_TX_ACTIONS_UNISWAP_V3_FACTORY_CONTRACT
              value: "{{ uniswap_v3_factory_contract | default('') }}"
            - name: INDEXER_TX_ACTIONS_UNISWAP_V3_NFT_POSITION_MANAGER_CONTRACT
              value: "{{ uniswap_v3_nft_position_manager_contract | default('') }}"
            - name: ETHEREUM_JSONRPC_DEBUG_TRACE_TRANSACTION_TIMEOUT
              value: "20s"
            - name: FIRST_BLOCK
              value: "2985520"
            - name: TRACE_FIRST_BLOCK
              value: "2985520"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: postgres
  template:
    metadata:
      labels:
        app: postgres
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      containers:
        - name: postgres
          image: {{ dex_explorer.images.postgres }}
          args: ["-c", "max_connections=500"]
          ports:
            - containerPort: 5432
          env:
            - name: POSTGRES_USER
              value: "{{ explorer_db.user }}"
            - name: POSTGRES_PASSWORD
              value: "{{ explorer_db.password }}"
            - name: POSTGRES_DB
              value: "blockscout-{{ dex_chain_id }}"
            - name: PGDATA
              value: /var/lib/postgresql/data/pgdata
            - name: POSTGRES_MAX_CONNECTIONS
              value: "200"
          resources:
            requests:
              memory: "1Gi"
              cpu: "0.5"
            limits:
              memory: "2Gi"
              cpu: "1"
          volumeMounts:
            - name: postgres-pvc
              mountPath: /var/lib/postgresql/data/pgdata
              subPath: pgdata
      volumes:
        - name: postgres-pvc
          persistentVolumeClaim:
            claimName: postgres-pvc
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: postgres-pvc
  namespace: "{{ dex_service_namespace }}"
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 100Gi
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: "{{ dex_service_namespace }}"
spec:
  ports:
    - port: 5432
  selector:
    app: postgres
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: blockscout-stats-configmap
  namespace: "{{ dex_service_namespace }}"
data:
  STATS__SERVER__HTTP__ENABLED: "true"
  STATS__SERVER__HTTP__ADDR: "0.0.0.0:8051"
  STATS__SERVER__HTTP__MAX_BODY_SIZE: "2097152"
  STATS__DEFAULT_SCHEDULE: "0 0 1 * * * *"
  STATS__TRACING__ENABLED: "true"
  STATS__TRACING__FORMAT: "default"
  STATS__DB_URL: "postgresql://{{ explorer_db.user }}:{{ explorer_db.password }}@postgres:5432/stats-{{ dex_chain_id }}"
  STATS__BLOCKSCOUT_DB_URL: "postgresql://{{ explorer_db.user }}:{{ explorer_db.password }}@postgres:5432/blockscout-{{ dex_chain_id }}"
  STATS__CREATE_DATABASE: "true"
  STATS__RUN_MIGRATIONS: "true"
  STATS__METRICS__ENABLED: "false"
  STATS__METRICS__ADDR: "0.0.0.0:6060"
  STATS__METRICS__ROUTE: "/metrics"
  STATS__BLOCKSCOUT_API_URL: "http://blockscout-backend:4000"
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-backend
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-backend
spec:
  type: ClusterIP
  selector:
    app: blockscout-backend
  ports:
    - targetPort: 4000
      port: 4000
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-stats
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-stats
spec:
  type: ClusterIP
  selector:
    app: blockscout-stats
  ports:
    - targetPort: 8051
      port: 8051
---
apiVersion: v1
kind: Service
metadata:
  name: blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
  labels:
    app: blockscout-frontend
spec:
  type: ClusterIP
  ports:
    - targetPort: 3000
      port: 3000
  selector:
    app: blockscout-frontend
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
  annotations:
    saga.xyz/ingress-protocol: "explorer"
spec:
  ingressClassName: nginx
  rules:
    - host: "{{ dex_explorer_frontend_url }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: blockscout-frontend
                port:
                  number: 3000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-blockscout-backend
  namespace: "{{ dex_service_namespace }}"
  annotations:
    nginx.org/websocket-services: blockscout-backend
    nginx.ingress.kubernetes.io/proxy-body-size: "10m"
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Access-Control-Allow-Headers *;
spec:
  ingressClassName: nginx
  rules:
    - host: "{{ dex_explorer_backend_url }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: blockscout-backend
                port:
                  number: 4000
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ingress-blockscout-stats
  namespace: "{{ dex_service_namespace }}"
  annotations:
    nginx.ingress.kubernetes.io/configuration-snippet: |
      add_header Access-Control-Allow-Origin *;
spec:
  ingressClassName: nginx
  rules:
    - host: "{{ dex_explorer_stats_url }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: blockscout-stats
                port:
                  number: 8051
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-backend
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-backend
  template:
    metadata:
      labels:
        app: blockscout-backend
    spec:
      containers:
        - name: blockscout-backend
          image: {{ dex_explorer.images.backend }}
          command:
            - /bin/sh
          args:
            - -c
            - bin/blockscout start
          ports:
            - containerPort: 4000
          envFrom:
            - configMapRef:
                name: blockscout-shared-configmap
          env:
            - name: APPLICATION_MODE
              value: "api"
            - name: DISABLE_INDEXER
              value: "true"
            - name: BLOCKSCOUT_HOST
              value: "{{ dex_explorer_backend_url }}"
            - name: BLOCKSCOUT_PROTOCOL
              value: "https"
            - name: WEBAPP_URL
              value: "https://{{ dex_explorer_frontend_url}}"
            - name: LOGO
              value: "/images/saga_logo.svg"
            - name: FOOTER_LOGO
              value: "/images/saga_logo.svg"
            - name: SHOW_TESTNET_LABEL
              value: "{{ is_testnet }}"
            - name: BLOCKSCOUT_VERSION
              value: "{{ blockscout_backend_version }}"
            - name: FOOTER_CHAT_LINK
              value: "https://discord.com/channels/950275843949736006"
            - name: FOOTER_GITHUB_LINK
              value: "http://github.com/sagaxyz"
            - name: DISPLAY_TOKEN_ICONS
              value: "true"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-frontend
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-frontend
  template:
    metadata:
      labels:
        app: blockscout-frontend
    spec:
      containers:
        - name: blockscout-frontend
          image: {{ dex_explorer.images.frontend }}
          ports:
            - containerPort: 3000
          envFrom:
            - configMapRef:
                name: blockscout-frontend-configmap
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: blockscout-stats
  namespace: "{{ dex_service_namespace }}"
spec:
  replicas: 1
  selector:
    matchLabels:
      app: blockscout-stats
  template:
    metadata:
      labels:
        app: blockscout-stats
    spec:
      containers:
        - name: blockscout-stats
          image: {{ dex_explorer.images.stats }}
          ports:
            - containerPort: 8051
          envFrom:
            - configMapRef:
                name: blockscout-stats-configmap
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: chainlet-fullnode
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: chainlet-fullnode
  template:
    metadata:
      labels:
        app: chainlet-fullnode
        chainId: "{{ dex_chain_id }}-fullnode"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "26660"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - image: "sagaxyz/sagaos:{{ dex_chainlet_version }}"
          name: chainlet
          command: ["bash", "/root/start-node.sh"]
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: chainlet-env
          ports:
            - containerPort: 26657
            - containerPort: 26656
            - containerPort: 9090
            - containerPort: 1317
            - containerPort: 8545
            - containerPort: 8546
            - containerPort: 26660
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - sagaosd status | jq -r '.SyncInfo.catching_up' | grep false
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              memory: "28Gi"
              cpu: "6"
            limits:
              memory: "31Gi"
              cpu: "7"
          volumeMounts:
            - name: data-volume
              mountPath: "/root/.sagaosd/data"
            - name: config-volume
              mountPath: "/root/.sagaosd/config"
            - name: scripts-volume
              mountPath: "/root/"
      volumes:
        - name: scripts-volume
          configMap:
            name: chainlet-scripts
            defaultMode: 0755
        - name: config-volume
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: data-volume
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: 200Gi
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: chainlet-fullnode-tracing
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: chainlet-fullnode-tracing
  template:
    metadata:
      labels:
        app: chainlet-fullnode-tracing
        chainId: "{{ dex_chain_id }}-fullnode-tracing"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "26660"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - image: "sagaxyz/sagaos:{{ dex_chainlet_version }}"
          name: chainlet
          command: ["bash", "/root/start-node.sh"]
          imagePullPolicy: Always
          env:
            - name: OPTS
              value: "--json-rpc.api eth,txpool,personal,net,debug,web3 --api.enabled-unsafe-cors --api.enable --grpc.address 0.0.0.0:9090 --json-rpc.address 0.0.0.0:8545 --json-rpc.enable true --json-rpc.api true --json-rpc.ws-address 0.0.0.0:8546 --json-rpc.gas-cap 50000000 --evm.tracer=struct"
          envFrom:
            - configMapRef:
                name: chainlet-env
          ports:
            - containerPort: 26657
            - containerPort: 26656
            - containerPort: 9090
            - containerPort: 1317
            - containerPort: 8545
            - containerPort: 8546
            - containerPort: 26660
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - sagaosd status | jq -r '.SyncInfo.catching_up' | grep false
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              memory: "28Gi"
              cpu: "6"
            limits:
              memory: "31Gi"
              cpu: "7"
          volumeMounts:
            - name: data-volume
              mountPath: "/root/.sagaosd/data"
            - name: config-volume
              mountPath: "/root/.sagaosd/config"
            - name: scripts-volume
              mountPath: "/root/"
      volumes:
        - name: scripts-volume
          configMap:
            name: chainlet-scripts
            defaultMode: 0755
        - name: config-volume
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: data-volume
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: 200Gi
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: chainlet-scripts
  namespace: {{ dex_service_namespace }}
data:
  start-node.sh: |
{% filter indent(width=4) %}
    {% include 'includes/start-node.sh' %}
{% endfilter %}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: chainlet-env
  namespace: {{ dex_service_namespace }}
data:
  CHAIN_ID: "{{ dex_chain_id }}"
  GENESIS_URL: "{{ dex_explorer.genesis_url }}"
  PEERS: "{{ dex_explorer.peers }}"
  DENOM: "{{ dex_explorer.denom }}"
  LOG_LEVEL: "info"
  MONIKER: "{{ moniker }}"
  PRUNING: "default"
  # SYNC_RPC: "{{ dex_explorer.sync_rpc_urls | join(',') }}"
---
apiVersion: v1
kind: Service
metadata:
  name: "chainlet-fullnode"
  namespace: {{ dex_service_namespace }}
spec:
  type: ClusterIP
  selector:
    app: "chainlet-fullnode"
  ports:
    - name: tendermintrpc
      port: 26657
      targetPort: 26657
    - name: tendermintrpc-p2p
      port: 26656
      targetPort: 26656
    - name: cosmosgrpc
      port: 9090
      targetPort: 9090
    - name: tendermintlcd
      port: 1317
      targetPort: 1317
    - name: evmjsonrpc
      port: 8545
      targetPort: 8545
    - name: evmws
      port: 8546
      targetPort: 8546
---
apiVersion: v1
kind: Service
metadata:
  name: "chainlet-fullnode-tracing"
  namespace: {{ dex_service_namespace }}
spec:
  type: ClusterIP
  selector:
    app: "chainlet-fullnode-tracing"
  ports:
    - name: tendermintrpc
      port: 26657
      targetPort: 26657
    - name: tendermintrpc-p2p
      port: 26656
      targetPort: 26656
    - name: cosmosgrpc
      port: 9090
      targetPort: 9090
    - name: tendermintlcd
      port: 1317
      targetPort: 1317
    - name: evmjsonrpc
      port: 8545
      targetPort: 8545
    - name: evmws
      port: 8546
      targetPort: 8546
