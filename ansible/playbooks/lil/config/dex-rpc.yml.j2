---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ dex_service_namespace }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: ethproxy-config
  namespace: {{ dex_service_namespace }}
data:
  ethproxy.yml: |
{% filter indent(width=4) %}
    {% include 'includes/ethproxy.yml.j2' %}
{% endfilter %}

---
apiVersion: v1
kind: Secret
metadata:
  name: ethproxy-secrets
  namespace: {{ dex_service_namespace }}
stringData:
  FEEPAYER_KEYS: "{{ feepayer_private_keys | join(',') }}"

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: chainlet-scripts
  namespace: {{ dex_service_namespace }}
data:
  start-node.sh: |
{% filter indent(width=4) %}
    {% include 'includes/start-node.sh' %}
{% endfilter %}

---
apiVersion: v1
kind: ConfigMap
metadata:
  name: chainlet-env
  namespace: {{ dex_service_namespace }}
data:
  CHAIN_ID: "{{ dex_chain_id }}"
  GENESIS_URL: "{{ dex_rpc.genesis_url }}"
  PEERS: "{{ dex_rpc.peers }}"
  DENOM: "{{ dex_rpc.denom }}"
  LOG_LEVEL: "info"
  SYNC_RPC: "{{ dex_rpc.sync_rpc_urls | join(',') }}"
  MONIKER: "{{ moniker }}"
  PRUNING: "default"
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: ethproxy
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ethproxy
  template:
    metadata:
      labels:
        app: ethproxy
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "9090"
    spec:
      containers:
      - name: ethproxy
        image: sagaxyz/ethproxy:{{ dex_rpc.ethproxy_version }}
        command:
        - /bin/sh
        - -c
        - |
          INDEX=${HOSTNAME##*-}
          export ETHPROXY_SERVICES_FEE_PAYER_PRIVATE_KEYS=$(echo $FEEPAYER_KEYS | tr ',' '\n' | sed -n "$((INDEX+1))p")
          exec /usr/bin/ethproxy -config /etc/saga/ethproxy/ethproxy.yml
        envFrom:
        - secretRef:
            name: ethproxy-secrets
        ports:
        - containerPort: 8545
        volumeMounts:
        - name: config-volume
          mountPath: /etc/saga/ethproxy
        resources:
          requests:
            memory: "4Gi"
            cpu: "2"
          limits:
            memory: "8Gi"
            cpu: "4"
      volumes:
      - name: config-volume
        configMap:
          name: ethproxy-config
          items:
          - key: ethproxy.yml
            path: ethproxy.yml
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: chainlet-rw
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 2
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: chainlet-rw
  template:
    metadata:
      labels:
        app: chainlet-rw
        chainId: "{{ dex_chain_id }}-rw"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "26660"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - image: "sagaxyz/sagaos:{{ dex_rpc.chainlet_version }}"
          name: chainlet
          command: ["bash", "/root/start-node.sh"]
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: chainlet-env
          ports:
            - containerPort: 26657
            - containerPort: 26656
            - containerPort: 9090
            - containerPort: 1317
            - containerPort: 8545
            - containerPort: 8546
            - containerPort: 26660
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - sagaosd status | jq -r '.SyncInfo.catching_up' | grep false
            initialDelaySeconds: 5
            periodSeconds: 5
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 4
          resources:
            requests:
              memory: "1Gi"
              cpu: "1"
            limits:
              memory: "4Gi"
              cpu: "2"
          volumeMounts:
            - name: data-volume
              mountPath: "/root/.sagaosd/data"
            - name: config-volume
              mountPath: "/root/.sagaosd/config"
            - name: scripts-volume
              mountPath: "/root/"
      volumes:
        - name: scripts-volume
          configMap:
            name: chainlet-scripts
            defaultMode: 0755
        - name: config-volume
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: data-volume
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: 100Gi
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: chainlet-ro
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 3
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: chainlet-ro
  template:
    metadata:
      labels:
        app: chainlet-ro
        chainId: "{{ dex_chain_id }}-ro"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "26660"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - image: "sagaxyz/sagaos:{{ dex_rpc.chainlet_version }}"
          name: chainlet
          command: ["bash", "/root/start-node.sh"]
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: chainlet-env
          ports:
            - containerPort: 26657
            - containerPort: 26656
            - containerPort: 9090
            - containerPort: 1317
            - containerPort: 8545
            - containerPort: 8546
            - containerPort: 26660
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - sagaosd status | jq -r '.SyncInfo.catching_up' | grep false
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              memory: "1Gi"
              cpu: "1"
            limits:
              memory: "4Gi"
              cpu: "2"
          volumeMounts:
            - name: data-volume
              mountPath: "/root/.sagaosd/data"
            - name: config-volume
              mountPath: "/root/.sagaosd/config"
            - name: scripts-volume
              mountPath: "/root/"
      volumes:
        - name: scripts-volume
          configMap:
            name: chainlet-scripts
            defaultMode: 0755
        - name: config-volume
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: data-volume
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: 100Gi
---
apiVersion: v1
kind: Service
metadata:
  name: ethproxy
  namespace: {{ dex_service_namespace }}
spec:
  selector:
    app: ethproxy
  ports:
  - port: 8545
    targetPort: 8545
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "ingress-ethproxy-jsonrpc"
  namespace: {{ dex_service_namespace }}
  annotations:
    saga.xyz/ingress-protocol: "jsonrpc"
spec:
  ingressClassName: nginx
  rules:
{% for url in rpc_url_suffixes %}
    - host: "sagaevm.jsonrpc.{{ url }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ethproxy
                port:
                  number: 8545
    - host: "{{ dex_chain_id | replace('_', '-') }}.jsonrpc.{{ url }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: ethproxy
                port:
                  number: 8545
{% endfor %}
---
apiVersion: v1
kind: Service
metadata:
  name: "chainlet-ro"
  namespace: {{ dex_service_namespace }}
spec:
  type: ClusterIP
  selector:
    app: "chainlet-ro"
  ports:
    - name: tendermintrpc
      port: 26657
      targetPort: 26657
    - name: tendermintrpc-p2p
      port: 26656
      targetPort: 26656
    - name: cosmosgrpc
      port: 9090
      targetPort: 9090
    - name: tendermintlcd
      port: 1317
      targetPort: 1317
    - name: evmjsonrpc
      port: 8545
      targetPort: 8545
    - name: evmws
      port: 8546
      targetPort: 8546
---
apiVersion: v1
kind: Service
metadata:
  name: "chainlet-rw"
  namespace: {{ dex_service_namespace }}
spec:
  type: ClusterIP
  selector:
    app: "chainlet-rw"
  ports:
    - name: tendermintrpc
      port: 26657
      targetPort: 26657
    - name: tendermintrpc-p2p
      port: 26656
      targetPort: 26656
    - name: cosmosgrpc
      port: 9090
      targetPort: 9090
    - name: tendermintlcd
      port: 1317
      targetPort: 1317
    - name: evmjsonrpc
      port: 8545
      targetPort: 8545
    - name: evmws
      port: 8546
      targetPort: 8546
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: chainlet-archive
  namespace: {{ dex_service_namespace }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: chainlet-archive
  template:
    metadata:
      labels:
        app: chainlet-archive
        chainId: "{{ dex_chain_id }}-archive"
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "26660"
    spec:
      nodeSelector:
        kubernetes.io/os: linux
      restartPolicy: Always
      containers:
        - image: "sagaxyz/sagaos:{{ dex_rpc.chainlet_version }}"
          name: chainlet
          command: ["bash", "/root/start-node.sh"]
          imagePullPolicy: Always
          envFrom:
            - configMapRef:
                name: chainlet-env
          env:
            - name: PRUNING
              value: "nothing"
            - name: SYNC_RPC
              value: ""
          ports:
            - containerPort: 26657
            - containerPort: 26656
            - containerPort: 9090
            - containerPort: 1317
            - containerPort: 8545
            - containerPort: 8546
            - containerPort: 26660
          readinessProbe:
            exec:
              command:
                - /bin/bash
                - -c
                - sagaosd status | jq -r '.SyncInfo.catching_up' | grep false
            initialDelaySeconds: 10
            periodSeconds: 10
            timeoutSeconds: 5
            successThreshold: 1
            failureThreshold: 3
          resources:
            requests:
              memory: "1Gi"
              cpu: "1"
            limits:
              memory: "4Gi"
              cpu: "2"
          volumeMounts:
            - name: data-volume
              mountPath: "/root/.sagaosd/data"
            - name: config-volume
              mountPath: "/root/.sagaosd/config"
            - name: scripts-volume
              mountPath: "/root/"
      volumes:
        - name: scripts-volume
          configMap:
            name: chainlet-scripts
            defaultMode: 0755
        - name: config-volume
          emptyDir: {}
  volumeClaimTemplates:
    - metadata:
        name: data-volume
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: 300Gi
---
apiVersion: v1
kind: Service
metadata:
  name: "chainlet-archive"
  namespace: {{ dex_service_namespace }}
spec:
  type: ClusterIP
  selector:
    app: "chainlet-archive"
  ports:
    - name: tendermintrpc
      port: 26657
      targetPort: 26657
    - name: tendermintrpc-p2p
      port: 26656
      targetPort: 26656
    - name: cosmosgrpc
      port: 9090
      targetPort: 9090
    - name: tendermintlcd
      port: 1317
      targetPort: 1317
    - name: evmjsonrpc
      port: 8545
      targetPort: 8545
    - name: evmws
