      targetPort: 8546
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "ingress-chainlet-archive-jsonrpc"
  namespace: {{ dex_service_namespace }}
  annotations:
    saga.xyz/ingress-protocol: "jsonrpc"
spec:
  ingressClassName: nginx
  rules:
{% for url in rpc_url_suffixes %}
    - host: "sagaevm-archive.jsonrpc.{{ url }}"
